# GEMINI_API_KEY: Optional — only if you use Gemini directly.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# OmniRoute AI Provider Configuration
# Use the Vite proxy path for local OmniRoute (recommended — avoids CORS):
VITE_OMNIROUTE_BASE_URL=/omniroute/v1
# Or call OmniRoute directly (requires CORS_ALLOWED_ORIGINS to include http://localhost:3000):
# VITE_OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Optional — OmniRoute REQUIRE_API_KEY is currently false locally.
# Set a key from OmniRoute Dashboard → API Keys when you enable auth.
VITE_OMNIROUTE_API_KEY=

# Model id as advertised by GET /v1/models (e.g. auto/best-chat, openai/gpt-4o-mini)
VITE_DEFAULT_MODEL=auto/best-chat
VITE_REQUEST_TIMEOUT=60000

# Supabase configuration for cloud database sync
VITE_SUPABASE_URL=https://vjxyopepafyhgenmuuwz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_O2LzRG3IqNFQ7y2d3NFDaQ_OfPabCqo
